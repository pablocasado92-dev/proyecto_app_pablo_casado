rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares de autenticación y propiedad
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Colección: Perfiles
    // Document ID: UID del usuario en Firebase Auth o mock_user_* para pruebas
    // ===============================================================
    match /Perfiles/{userId} {
      // Permite la lectura a usuarios autenticados para explorar perfiles y chatear
      allow read: if isAuthenticated();

      // Solo el propio usuario puede crear su perfil (o perfiles de prueba en desarrollo)
      allow create, update: if isOwner(userId) || (isAuthenticated() && userId.matches('mock_user_.*'));

      // Solo el propio usuario puede eliminar su documento de perfil (o perfiles mock)
      allow delete: if isOwner(userId) || (isAuthenticated() && userId.matches('mock_user_.*'));
    }

    // ===============================================================
    // Colección: Mensajes
    // Document ID: Autogenerado o ID del mensaje
    // ===============================================================
    match /Mensajes/{messageId} {
      // Permite la lectura a cualquier usuario autenticado
      allow read: if isAuthenticated();

      // Permite enviar mensajes si el remitente coincide con el usuario autenticado
      allow create: if isAuthenticated() && (
        request.resource.data.remitenteUID == request.auth.uid ||
        request.resource.data.remitenteUID == request.auth.token.email
      );

      // Permite modificar si es el autor (ej: editar mensaje) o destinatario (marcar leído: leido = true)
      allow update: if isAuthenticated() && (
        resource.data.remitenteUID == request.auth.uid ||
        resource.data.remitenteUID == request.auth.token.email ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido'])
      );

      // Solo el remitente del mensaje puede eliminarlo (Bloque 3 - 0486 RA4.f)
      allow delete: if isAuthenticated() && (
        resource.data.remitenteUID == request.auth.uid ||
        resource.data.remitenteUID == request.auth.token.email
      );
    }
  }
}
